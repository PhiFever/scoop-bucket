{
    "version": "1.5.0.6",
    "description": "在 Windows 上统计软件使用时长和网站浏览时长",
    "homepage": "https://github.com/Planshit/Tai",
    "license": "MIT",
    "notes": "请用 scoop update tai 升级，不要用设置页里的内置更新器。",
    "url": "https://github.com/Planshit/Tai/releases/download/1.5.0.6/Tai1.5.0.6.zip",
    "hash": "7d55788ab79ecf7893ee5e160496698bc772511d9600336524d1858369766327",
    "shortcuts": [
        [
            "Tai.exe",
            "Tai"
        ]
    ],
    "persist": [
        "Data",
        "AppIcons",
        "Log"
    ],
    "pre_uninstall": [
        "if ($cmd -eq 'uninstall' -and (Get-ScheduledTask -TaskName 'Tai task' -ErrorAction SilentlyContinue)) {",
        "    try { Start-Process schtasks.exe -ArgumentList '/delete /tn \"Tai task\" /f' -Verb RunAs -Wait -WindowStyle Hidden } catch {}",
        "    if (Get-ScheduledTask -TaskName 'Tai task' -ErrorAction SilentlyContinue) {",
        "        warn \"未能删除开机自启任务 'Tai task'，请在任务计划程序里手动删除。\"",
        "    }",
        "}"
    ],
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/Planshit/Tai/releases/download/$version/Tai$version.zip"
    }
}
